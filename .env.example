# App
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME=AgentDesk AI

# Local UI without Supabase (demo org + mock providers). Set false when using real Auth.
LOCAL_DEMO_MODE=true
NEXT_PUBLIC_LOCAL_DEMO_MODE=true

# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
DATABASE_URL=postgresql://postgres:password@db.your-project.supabase.co:5432/postgres

# Auth redirects
NEXT_PUBLIC_SUPABASE_AUTH_REDIRECT_URL=http://localhost:3000/auth/callback

# Provider selection (mock = local development without external accounts)
VOICE_PROVIDER=mock
# MVP inbound AI path uses Vapi-native numbers: TELEPHONY_PROVIDER=vapi
TELEPHONY_PROVIDER=mock
BILLING_PROVIDER=mock
CALENDAR_PROVIDER=mock
JOBS_PROVIDER=local

# Vapi (when VOICE_PROVIDER=vapi and/or TELEPHONY_PROVIDER=vapi) — primary for Telugu + English
VAPI_API_KEY=
# Shared secret Vapi sends to /api/webhooks/vapi (Authorization Bearer or x-vapi-secret)
VAPI_WEBHOOK_SECRET=
# Optional: default Vapi phone number id for outbound test calls
VAPI_PHONE_NUMBER_ID=
VAPI_FROM_NUMBER=

# Retell AI (optional fallback: VOICE_PROVIDER=retell / TELEPHONY_PROVIDER=retell)
RETELL_API_KEY=
RETELL_WEBHOOK_SECRET=
# Optional fallback from-number for outbound test calls (else use a provisioned Retell number)
RETELL_FROM_NUMBER=

# Twilio (when TELEPHONY_PROVIDER=twilio — optional; not required for MVP inbound)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
TWILIO_WEBHOOK_BASE_URL=http://localhost:3000

# Stripe (when BILLING_PROVIDER=stripe)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_STARTER=
STRIPE_PRICE_STARTER_ANNUAL=
STRIPE_PRICE_PROFESSIONAL=
STRIPE_PRICE_PROFESSIONAL_ANNUAL=
STRIPE_PRICE_BUSINESS=
STRIPE_PRICE_BUSINESS_ANNUAL=

# Email
RESEND_API_KEY=
NOTIFICATION_FROM_EMAIL=calls@yourdomain.com

# Marketing AI chat agent (homepage widget)
# Preferred: Cursor API key from https://cursor.com/dashboard/integrations
CURSOR_API_KEY=
CURSOR_MODEL=composer-2.5
# Fallback OpenAI-compatible provider
OPENAI_API_KEY=
# OPENAI_BASE_URL=https://api.openai.com/v1
# AI_GATEWAY_API_KEY=
LLM_MODEL=gpt-4o-mini

# Observability (optional)
SENTRY_DSN=
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=

# Security
# Used by lib/crypto/integration-secrets.ts (AES-GCM) for secrets_encrypted columns
INTEGRATION_SECRETS_ENCRYPTION_KEY=change-me-32-chars-minimum!!!!
INTERNAL_API_SECRET=change-me-in-production

# Webhooks — only enable org fallback for single-tenant staging (never multi-tenant prod)
# ALLOW_WEBHOOK_ORG_FALLBACK=true
# DEFAULT_WEBHOOK_ORG_ID=

# --- Legacy (deprecated — not used by AgentDesk Phase 1) ---
# CLERK_* / DEEPGRAM_API_KEY / VOICE_WORKER_* / OPENAI_* for old VoiceLead worker
